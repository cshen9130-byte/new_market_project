# MOM analysis data directory (outside project folder, persists across deployments)
MOM_DATA_DIR=/root/market_dashboard_storage/03.投顾逐日

# Client-side MOM report alias (served by Nginx)
NEXT_PUBLIC_MOM_REPORT_URL=/mom_report/report.html

# Shared external storage root for auth and other persistent server data
MARKET_DASHBOARD_STORAGE_DIR=/root/market_dashboard_storage

# External AI knowledge base storage directory (outside the project folder)
AI_KB_STORAGE_DIR=/root/market_dashboard_storage/ai-knowledge-base

# DashScope / Qwen configuration for AI knowledge base chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Credentials for EmQuant API (set on server, do not commit real values)
EMQ_USERNAME=
EMQ_PASSWORD=
EMQ_OPTIONS_EXTRA=LoginType=2

# Python executable for server venv
PYTHON_EXE=/root/new_market_project/.venv/bin/python3

# Tushare token for Python data fetchers
TUSHARE_TOKEN=

# Optional library path if needed by EmQuant
LD_LIBRARY_PATH=/root/new_market_project/EMQuantAPI_Python/EMQuantAPI_Python/python3/libs/linux/x64

# Optional CTP live market sidecar (services/ctp_market, PM2 app ctp_market)
# Use SimNow on the server (.env CTP_USER_ID / CTP_PASSWORD). Sidecar binds 127.0.0.1:8000.
CTP_MARKET_URL=http://127.0.0.1:8000
CTP_PROFILE=simnow
CTP_BROKER_ID=9999
CTP_USER_ID=
CTP_PASSWORD=
CTP_INSTRUMENTS=IM2609,IM2608,IF2609,IF2608,IH2609,IH2608,IC2609,IC2608
SIMNOW_MD_FRONT=tcp://182.254.243.31:30011