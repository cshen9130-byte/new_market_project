{
  "expo": {
    "name": "母基金投研",
    "slug": "fof-research",
    "scheme": "fofresearch",
    "version": "1.6.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketwebsite.fofresearch",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "Used for AI assistant voice input.",
        "NSSpeechRecognitionUsageDescription": "Used for AI assistant voice input."
      }
    },
    "android": {
      "package": "com.marketwebsite.fofresearch",
      "versionCode": 22,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidCleartext",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for AI voice input.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to use speech recognition for AI voice input.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
