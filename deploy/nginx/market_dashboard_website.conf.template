server {
    listen 80;
    server_name __DOMAIN__;
    # Default body limit for normal requests.
    client_max_body_size 50m;

    # Knowledge-base uploads can be large; allow bigger payloads and stream them.
    location /api/knowledge-base/upload {
        client_max_body_size 1024m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 10s;
    }

    # Long-running mailbox crawl APIs (IMAP + attachment parsing can exceed 5 minutes)
    location ~ ^/ma/api/ops/(email-parse-records/fetch|ta-accounts/fetch)$ {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_connect_timeout 10s;
    }

    # Proxy Next.js app (running with pm2 on localhost)
    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # AI chat / vector-store indexing can take a while — raise timeouts
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 10s;
    }

    # Static alias for MOM report (served directly by Nginx)
    location /mom_report/ {
        alias __ABS_MOM_PATH__/;
        autoindex off;
        index report.html;
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /mom_report/report.html;
    }
}
