# Copied to the project .env by setup-choice-emquant.sh. Do not commit secrets.
CTP_PROFILE=simnow
CTP_BROKER_ID=9999
CTP_USER_ID=
CTP_PASSWORD=
# Optional extra symbols. IH/IF/IC/IM always include the 4 listed CFFEX months
# (current, next, next two quarters), even if this is empty or only has 2 months.
CTP_INSTRUMENTS=
SIMNOW_MD_FRONT=tcp://182.254.243.31:30011
# After hours the 30011 仿真 front is down; sidecar fails over to 7x24:
# tcp://182.254.243.31:40011
CHART_HOST=127.0.0.1
CHART_PORT=8000
CTP_MARKET_URL=http://127.0.0.1:8000
